rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules dùng chung: đọc dữ liệu theo quyền và tạo chuyến hợp lệ.
    function signedIn() {
      return request.auth != null;
    }

    // Kiểm tra UID của tài khoản đang đăng nhập.
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

        match /users/{userId} {
      // Hồ sơ riêng chỉ chứa email, biển số và thời gian.
      function validPrivateProfileCreate() {
        let data = request.resource.data;
        let publicData = getAfter(
          /databases/$(database)/documents/publicProfiles/$(userId)
        ).data;

        return data.keys().hasAll([
            'email', 'vehiclePlate', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'email', 'vehiclePlate', 'createdAt', 'updatedAt'
          ])
          && data.email is string
          && data.email == request.auth.token.email
          && data.vehiclePlate is string
          && data.vehiclePlate.size() <= 20
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && publicData.displayName is string
          && publicData.displayName.size() > 0
          && publicData.vehicleName is string
          && (
            (data.vehiclePlate.size() == 0
              && publicData.vehicleName.size() == 0)
            || (data.vehiclePlate.size() > 0
              && publicData.vehicleName.size() > 0)
          );
      }

      allow get: if isOwner(userId);

      allow create: if isOwner(userId)
        && validPrivateProfileCreate();

      allow list, update, delete: if false;
    }

    match /publicProfiles/{userId} {
      // Hồ sơ công khai không chứa email hoặc biển số.
      function validPublicProfileCreate() {
        let data = request.resource.data;
        let privateData = getAfter(
          /databases/$(database)/documents/users/$(userId)
        ).data;

        return data.keys().hasAll([
            'displayName', 'vehicleName', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'displayName', 'vehicleName', 'createdAt', 'updatedAt'
          ])
          && data.displayName is string
          && data.displayName.size() > 0
          && data.displayName.size() <= 80
          && data.vehicleName is string
          && data.vehicleName.size() <= 80
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && privateData.email == request.auth.token.email
          && privateData.vehiclePlate is string
          && (
            (data.vehicleName.size() == 0
              && privateData.vehiclePlate.size() == 0)
            || (data.vehicleName.size() > 0
              && privateData.vehiclePlate.size() > 0)
          );
      }

      allow read: if signedIn();

      allow create: if isOwner(userId)
        && validPublicProfileCreate();

      allow update, delete: if false;
    }

    match /trips/{tripId} {
      allow read: if signedIn();

      // Cho phép tạo chuyến chính chủ khi đủ hồ sơ xe và dữ liệu hợp lệ.
      allow create: if signedIn()
        && hasVehicleProfile()
        && validTripCreate();

      // Quyền sửa/hủy/hoàn thành sẽ bổ sung theo từng thao tác.
      allow update, delete: if false;
    }

    match /requests/{requestId} {
      allow read: if signedIn()
        && (resource.data.passengerId == request.auth.uid
          || resource.data.driverId == request.auth.uid);
      allow write: if false;
    }

        match /favorites/{favoriteId} {
      // Dữ liệu yêu thích phải đúng schema và thuộc người đăng nhập.
      function validFavoriteCreate() {
        let data = request.resource.data;

        return data.keys().hasAll(['userId', 'tripId', 'createdAt'])
          && data.keys().hasOnly(['userId', 'tripId', 'createdAt'])
          && data.userId == request.auth.uid
          && data.tripId is string
          && data.tripId.size() > 0
          && data.tripId.matches('[^/]+')
          && favoriteId == request.auth.uid + '_' + data.tripId
          && exists(
            /databases/$(database)/documents/trips/$(data.tripId)
          )
          && data.createdAt is timestamp
          && data.createdAt == request.time;
      }

      // Đọc bản ghi chính chủ; cho phép kiểm tra ID chính chủ chưa tồn tại.
      allow get: if signedIn()
        && (
          (
            exists(
              /databases/$(database)/documents/favorites/$(favoriteId)
            )
            && resource.data.userId == request.auth.uid
          )
          || (
            !exists(
              /databases/$(database)/documents/favorites/$(favoriteId)
            )
            && favoriteId.matches(request.auth.uid + '_[^/]+')
          )
        );

      // Query danh sách phải lọc userId bằng UID đang đăng nhập.
      allow list: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if signedIn() && validFavoriteCreate();

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      // Không sửa chủ sở hữu, chuyến hoặc thời gian của bản ghi đã tạo.
      allow update: if false;
    }

    match /ratings/{ratingId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.recipientId == request.auth.uid;
      allow write: if false;
    }

    // Chặn mọi đường dẫn chưa được khai báo.
    match /{document=**} {
      allow read, write: if false;
    }

    // Kiểm tra địa điểm có đúng cấu trúc và tọa độ hợp lệ.
    function validPlace(place) {
      return place is map
        && place.keys().hasAll(['name', 'latitude', 'longitude'])
        && place.keys().hasOnly(['name', 'latitude', 'longitude'])
        && place.name is string
        && place.name.size() > 0
        && (place.latitude is int || place.latitude is float)
        && (place.longitude is int || place.longitude is float)
        && place.latitude >= -90
        && place.latitude <= 90
        && place.longitude >= -180
        && place.longitude <= 180;
    }

    // Chủ xe phải có tên xe và biển số trong hồ sơ chính chủ.
    function hasVehicleProfile() {
      let userPath =
        /databases/$(database)/documents/users/$(request.auth.uid);
      let publicPath =
        /databases/$(database)/documents/publicProfiles/$(request.auth.uid);

      return exists(userPath)
        && exists(publicPath)
        && get(userPath).data.vehiclePlate is string
        && get(userPath).data.vehiclePlate.size() > 0
        && get(publicPath).data.vehicleName is string
        && get(publicPath).data.vehicleName.size() > 0;
    }

    // Chuyến mới phải đúng schema và trạng thái ban đầu đã chốt.
    function validTripCreate() {
      let data = request.resource.data;
      let fields = [
        'driverId', 'origin', 'destination', 'departureAt',
        'costVnd', 'note', 'status', 'availableSeats',
        'acceptedRequestId', 'createdAt', 'updatedAt'
      ];

      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.driverId is string
        && data.driverId == request.auth.uid
        && validPlace(data.origin)
        && validPlace(data.destination)
        && (
          data.origin.latitude != data.destination.latitude
          || data.origin.longitude != data.destination.longitude
        )
        && data.departureAt is timestamp
        && data.departureAt > request.time
        && data.costVnd is int
        && data.costVnd >= 0
        && data.note is string
        && data.status == 'OPEN'
        && data.availableSeats is int
        && data.availableSeats == 1
        && data.acceptedRequestId == ''
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }
  }
}
