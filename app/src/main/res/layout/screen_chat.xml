<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/screen_header_height"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">
        <ImageButton
            android:id="@+id/header_back"
            style="@style/IconButton"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại" />
        <TextView
            android:id="@+id/header_title"
            style="@style/Subtitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingHorizontal="8dp"
            android:text="Trò chuyện" />
    </LinearLayout>
    <TextView
        android:id="@+id/chat_context"
        style="@style/Caption"
        android:layout_width="match_parent"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:maxLines="3"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/chat_status"
        style="@style/Caption"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:accessibilityLiveRegion="polite" />
    <TextView
        android:id="@+id/chat_cache_hint"
        style="@style/Caption"
        android:paddingHorizontal="20dp"
        android:visibility="gone" />
    <Button
        android:id="@+id/chat_retry_connection"
        style="@style/ButtonSecondary"
        android:text="Kết nối lại"
        android:layout_marginHorizontal="20dp"
        android:visibility="gone" />
    <Button
        android:id="@+id/chat_load_older"
        style="@style/ButtonSecondary"
        android:text="Tải tin cũ hơn"
        android:layout_marginHorizontal="20dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/chat_empty"
        style="@style/Body"
        android:layout_width="match_parent"
        android:gravity="center"
        android:padding="20dp"
        android:text="Chưa có tin nhắn. Hãy trao đổi điểm đón với nhau."
        android:visibility="gone" />
    <ListView
        android:id="@+id/chat_message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:stackFromBottom="true"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false" />
    <TextView
        android:id="@+id/chat_pending"
        style="@style/Body"
        android:maxLines="3"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:padding="12dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_lavender"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">
        <Button
            android:id="@+id/chat_retry_send"
            style="@style/ButtonSecondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Thử gửi lại"
            android:visibility="gone" />
        <Button
            android:id="@+id/chat_discard"
            style="@style/ButtonSecondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Bỏ chờ gửi"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:padding="12dp">
        <EditText
            android:id="@+id/chat_input"
            style="@style/Input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:singleLine="false"
            android:minLines="1"
            android:maxLines="4"
            android:maxLength="1000"
            android:inputType="textCapSentences|textMultiLine"
            android:hint="Nhập tin nhắn…"
            android:importantForAutofill="no"
            android:saveEnabled="false" />
        <Button
            android:id="@+id/send_message"
            style="@style/ButtonPrimary"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="0dp"
            android:text="Gửi" />
    </LinearLayout>
</LinearLayout>
