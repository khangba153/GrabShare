<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout style="@style/Row">
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_user"
            android:contentDescription="Hồ sơ công khai của chủ xe" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/driver_name"
                style="@style/BodyBold"
                android:text="Chủ xe" />
            <TextView
                android:id="@+id/driver_meta"
                style="@style/Caption"
                android:text="Thông tin xe" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/view_route" />

    <LinearLayout style="@style/Row">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_clock"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/trip_time"
            style="@style/Caption"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Chưa có giờ khởi hành" />
        <TextView
            android:id="@+id/trip_cost"
            style="@style/Badge"
            android:text="Chưa có chi phí" />
    </LinearLayout>

    <TextView
        android:id="@+id/trip_status"
        style="@style/Badge"
        android:layout_marginTop="8dp"
        android:text="Trạng thái" />
</LinearLayout>
