<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginVertical="6dp"
    android:padding="16dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <TextView
        android:id="@+id/match_driver"
        style="@style/Subtitle"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/match_vehicle"
        style="@style/Caption"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_width="match_parent" />
    <TextView
        android:id="@+id/match_time"
        style="@style/Body"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_width="match_parent" />
    <TextView
        android:id="@+id/match_price"
        style="@style/Subtitle"
        android:textColor="@color/primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/match_full_trip_cost"
        style="@style/Caption"
        android:visibility="gone" />
    <TextView
        android:id="@+id/match_passenger_distance"
        style="@style/Body"
        android:visibility="gone" />
    <TextView
        android:id="@+id/match_route"
        style="@style/Body"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/match_gap"
        style="@style/Body"
        android:visibility="gone" />
    <TextView
        android:id="@+id/match_detour"
        style="@style/Body"
        android:textColor="@color/primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_width="match_parent" />
    <TextView
        android:id="@+id/match_note"
        style="@style/Hint"
        android:visibility="gone" />
</LinearLayout>
