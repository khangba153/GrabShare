<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/passenger_search_route"
    style="@style/Card"
    android:orientation="vertical"
    android:visibility="gone">
    <TextView
        style="@style/Subtitle"
        android:text="Lộ trình đi nhờ của bạn" />
    <TextView
        style="@style/Caption"
        android:text="Điểm đón" />
    <TextView
        android:id="@+id/passenger_search_pickup"
        style="@style/Body"
        android:layout_width="match_parent" />
    <TextView
        style="@style/Caption"
        android:layout_marginTop="12dp"
        android:text="Điểm xuống" />
    <TextView
        android:id="@+id/passenger_search_dropoff"
        style="@style/Body"
        android:layout_width="match_parent" />
</LinearLayout>
