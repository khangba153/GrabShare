<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/screen_header_height"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">
        <ImageButton
            android:id="@+id/header_back"
            style="@style/IconButton"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại" />
        <TextView
            android:id="@+id/header_title"
            style="@style/Subtitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Tin nhắn"
            android:layout_marginStart="12dp" />
        <ImageButton
            android:id="@+id/header_chat"
            style="@style/IconButton"
            android:src="@drawable/ic_chat"
            android:contentDescription="Tin nhắn"
            android:visibility="gone" />
        <ImageButton
            android:id="@+id/header_action"
            style="@style/IconButton"
            android:src="@drawable/ic_bell"
            android:contentDescription="Thông báo" />
    </LinearLayout>
    <TextView
        android:id="@+id/chat_tab_messages"
        style="@style/Caption"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:text="Cuộc trò chuyện của bạn" />
    <TextView
        android:id="@+id/chat_inbox_status"
        style="@style/Body"
        android:layout_width="match_parent"
        android:gravity="center"
        android:padding="20dp"
        android:text="Đang tải tin nhắn…"
        android:accessibilityLiveRegion="polite" />
    <Button
        android:id="@+id/chat_inbox_retry"
        style="@style/ButtonSecondary"
        android:layout_marginHorizontal="20dp"
        android:text="Thử lại"
        android:visibility="gone" />
    <ListView
        android:id="@+id/chat_conversations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />
</LinearLayout>
