<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/screen_header_height"
        android:paddingHorizontal="12dp">
        <ImageButton
            android:id="@+id/header_back"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại" />
        <TextView
            style="@style/Subtitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="52dp"
            android:gravity="center"
            android:text="@string/account_terms_title" />
        <ImageButton
            android:id="@+id/header_action"
            style="@style/IconButton"
            android:src="@drawable/ic_bell"
            android:contentDescription="Thông báo"
            android:layout_gravity="center_vertical|end" />
    </FrameLayout>
    <ScrollView
        android:id="@+id/terms_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                style="@style/Title"
                android:text="@string/account_terms_title" />
            <TextView
                style="@style/Body"
                android:text="@string/leader_terms_intro"
                android:textIsSelectable="true" />
            <TextView
                style="@style/Hint"
                android:text="@string/leader_local_content" />
            <LinearLayout
                style="@style/Card">
                <TextView
                    android:id="@+id/terms_content"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/account_terms_content"
                    android:textIsSelectable="true" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                style="@style/ButtonSecondary"
                android:id="@+id/static_page_back"
                android:text="@string/leader_back"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
