<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="12dp"
        android:visibility="visible">

        <ImageButton
            android:id="@+id/header_back"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại"
            android:visibility="visible" />

        <TextView
            android:id="@+id/header_title"
            style="@style/Subtitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="52dp"
            android:layout_marginBottom="0dp"
            android:gravity="center"
            android:text="Chọn địa điểm" />

        <ImageButton
            android:id="@+id/header_action"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|end"
            android:src="@drawable/ic_bell"
            android:contentDescription="Thông báo"
            android:visibility="gone" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    style="@style/Caption"
                    android:text="Tìm địa điểm" />

                <EditText
                    android:id="@+id/location_search"
                    style="@style/Input"
                    android:inputType="text|textNoSuggestions|textFilter"
                    android:hint="Nhập địa chỉ, khu vực…"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <!-- Gợi ý kết quả tìm kiếm -->
            <TextView
                android:id="@+id/location_suggestion_title"
                style="@style/Subtitle"
                android:text="Kết quả tìm kiếm"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/location_status_text"
                style="@style/Body"
                android:text="Đang tìm kiếm..."
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/location_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Yêu cầu Attribution từ LocationIQ / OpenStreetMap -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                style="@style/Caption"
                android:textColor="@color/muted"
                android:text="Dữ liệu địa điểm cung cấp bởi LocationIQ.com\n© OpenStreetMap contributors" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/action_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:background="@color/background"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/primary_action"
            style="@style/ButtonPrimary"
            android:text="Tìm kiếm" />
    </LinearLayout>
</LinearLayout>
