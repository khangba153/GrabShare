<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_lavender"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Minh họa tuyến đường đi cùng"
        android:scaleType="fitXY"
        android:src="@drawable/map_route" />

    <TextView
        android:id="@+id/map_start_label"
        style="@style/Badge"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@drawable/bg_card"
        android:ellipsize="end"
        android:maxLines="2"
        android:maxWidth="200dp"
        android:text="Công viên Lê Văn Tám"
        android:textColor="@color/ink" />

    <TextView
        android:id="@+id/map_end_label"
        style="@style/Badge"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:background="@drawable/bg_card"
        android:ellipsize="end"
        android:maxLines="2"
        android:maxWidth="200dp"
        android:text="Khu dân cư An Phú"
        android:textColor="@color/ink" />
</FrameLayout>
