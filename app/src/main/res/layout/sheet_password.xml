<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_sheet" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <View android:layout_width="36dp" android:layout_height="4dp" android:layout_gravity="center" android:background="@color/border" android:layout_marginBottom="20dp" />
        <TextView style="@style/Subtitle" android:text="Quên mật khẩu?" />
        <TextView style="@style/Hint" android:text="Nhập email đã đăng ký để nhận liên kết đặt lại mật khẩu." />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
            <TextView style="@style/Caption" android:text="Email" />
            <EditText android:id="@+id/recovery_email" style="@style/Input" android:inputType="textEmailAddress" android:hint="Email của bạn" android:importantForAutofill="no" android:focusable="false" android:focusableInTouchMode="false" android:cursorVisible="false" android:longClickable="false" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/sheet_submit" style="@style/ButtonPrimary" android:text="Gửi liên kết" android:clickable="false" android:focusable="false" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/sheet_cancel" style="@style/ButtonSecondary" android:text="Quay lại đăng nhập" android:clickable="false" android:focusable="false" />
    </LinearLayout>
</ScrollView>
