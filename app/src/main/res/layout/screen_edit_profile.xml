<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/screen_header_height"
        android:paddingHorizontal="12dp">
        <ImageButton
            android:id="@+id/header_back"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại" />
        <TextView
            style="@style/Subtitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="52dp"
            android:gravity="center"
            android:text="Chỉnh sửa hồ sơ" />
        <ImageButton
            android:id="@+id/header_action"
            style="@style/IconButton"
            android:src="@drawable/ic_bell"
            android:contentDescription="Thông báo"
            android:layout_gravity="center_vertical|end" />
    </FrameLayout>
    <ScrollView
        android:id="@+id/profile_edit_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                style="@style/Title"
                android:text="@string/leader_profile_intro" />
            <TextView
                style="@style/Hint"
                android:text="@string/leader_profile_draft_hint" />
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_user"
                android:contentDescription="Biểu tượng tài khoản" />
            <ProgressBar
                android:id="@+id/profile_edit_loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />
            <TextView
                android:id="@+id/profile_edit_status"
                style="@style/AccountFeedback"
                android:layout_width="match_parent"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/profile_edit_retry"
                style="@style/ButtonSecondary"
                android:text="@string/profile_retry"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
            <LinearLayout
                style="@style/Card">
                <TextView
                    style="@style/Caption"
                    android:labelFor="@id/profile_name_input"
                    android:text="Họ và tên" />
                <EditText
                    android:id="@+id/profile_name_input"
                    style="@style/Input"
                    android:hint="Từ 1 đến 80 ký tự"
                    android:inputType="textPersonName"
                    android:importantForAutofill="no"
                    android:saveEnabled="false"
                    android:imeOptions="actionNext"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
                <TextView
                    style="@style/Caption"
                    android:layout_marginTop="16dp"
                    android:text="Email đăng nhập" />
                <TextView
                    android:id="@+id/profile_email"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:textIsSelectable="true" />
                <TextView
                    style="@style/Hint"
                    android:layout_width="match_parent"
                    android:text="@string/profile_email_hint" />
            </LinearLayout>
            <LinearLayout
                style="@style/Card">
                <TextView
                    style="@style/Caption"
                    android:labelFor="@id/profile_vehicle_input"
                    android:text="Tên xe" />
                <EditText
                    android:id="@+id/profile_vehicle_input"
                    style="@style/Input"
                    android:hint="Ví dụ: Honda Wave"
                    android:inputType="textCapWords"
                    android:importantForAutofill="no"
                    android:saveEnabled="false"
                    android:imeOptions="actionNext"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
                <TextView
                    style="@style/Caption"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/profile_plate_input"
                    android:text="Biển số xe" />
                <EditText
                    android:id="@+id/profile_plate_input"
                    style="@style/Input"
                    android:hint="Tối đa 20 ký tự"
                    android:inputType="textCapCharacters"
                    android:importantForAutofill="no"
                    android:saveEnabled="false"
                    android:imeOptions="actionNext"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
                <TextView
                    style="@style/Hint"
                    android:layout_width="match_parent"
                    android:text="@string/profile_vehicle_hint" />
                <TextView
                    style="@style/Hint"
                    android:layout_width="match_parent"
                    android:text="@string/profile_private_hint" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="0dp"
                android:paddingBottom="12dp">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/primary_action"
                    style="@style/ButtonPrimary"
                    android:enabled="false"
                    android:text="@string/profile_save"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/secondary_action"
                    style="@style/ButtonSecondary"
                    android:text="@string/profile_cancel"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
