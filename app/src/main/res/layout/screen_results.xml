<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background" android:descendantFocusability="blocksDescendants" android:importantForAccessibility="noHideDescendants">
    <FrameLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="64dp" android:paddingHorizontal="12dp" android:visibility="visible">
        <ImageButton android:id="@+id/header_back" style="@style/IconButton" android:layout_gravity="center_vertical|start" android:src="@drawable/ic_back" android:contentDescription="Quay lại" android:visibility="visible" android:clickable="false" android:focusable="false" />
        <TextView android:id="@+id/header_title" style="@style/Subtitle" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginHorizontal="52dp" android:layout_marginBottom="0dp" android:gravity="center" android:text="Chuyến phù hợp" />
        <ImageButton android:id="@+id/header_action" style="@style/IconButton" android:layout_gravity="center_vertical|end" android:src="@drawable/ic_bell" android:contentDescription="Thông báo" android:visibility="visible" android:clickable="false" android:focusable="false" />
    </FrameLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:fillViewport="true" android:clipToPadding="false" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="8dp" android:paddingBottom="24dp">
            <LinearLayout style="@style/Card" android:background="@drawable/bg_lavender">
                <include layout="@layout/view_route" />
                <TextView android:id="@+id/search_summary" style="@style/Caption" android:text="Hôm nay · 17:30" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/open_filters" style="@style/ButtonSecondary" android:text="Bộ lọc · Giờ đi, chi phí, đánh giá" android:clickable="false" android:focusable="false" />
            <TextView style="@style/Subtitle" android:text="Chuyến phù hợp với bạn" android:layout_marginTop="18dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/ride_list">
                <LinearLayout style="@style/Card" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
                    <LinearLayout style="@style/Row">
                        <ImageView android:id="@+id/driver_avatar" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/avatar_1" android:contentDescription="Ảnh chủ xe" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:id="@+id/driver_name" style="@style/BodyBold" android:text="Thanh Minh" />
                            <TextView android:id="@+id/driver_meta" style="@style/Caption" android:text="★ 4.9 · Honda Wave" />
                        </LinearLayout>
                        <TextView android:id="@+id/verified_badge" style="@style/Badge" android:text="Đã xác minh" />
                    </LinearLayout>
                    <LinearLayout style="@style/Row">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_clock" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/ride_time" style="@style/Body" android:text="17:30" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" />
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_user" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/ride_seats" style="@style/Caption" android:text="1 chỗ" android:layout_marginHorizontal="6dp" />
                        <TextView android:id="@+id/ride_price" style="@style/Badge" android:text="15.000đ" android:background="@drawable/bg_price" android:textColor="@color/ink" />
                    </LinearLayout>
                    <LinearLayout style="@style/Row">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_pin" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/ride_pickup" style="@style/Caption" android:text="Đón tại cổng công viên" android:layout_marginStart="8dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/Card" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
                    <LinearLayout style="@style/Row">
                        <ImageView android:id="@+id/driver_avatar" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/avatar_2" android:contentDescription="Ảnh chủ xe" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:id="@+id/driver_name" style="@style/BodyBold" android:text="Mai Hương" />
                            <TextView android:id="@+id/driver_meta" style="@style/Caption" android:text="★ 4.8 · Honda Vision" />
                        </LinearLayout>
                        <TextView android:id="@+id/verified_badge" style="@style/Badge" android:text="Đã xác minh" />
                    </LinearLayout>
                    <LinearLayout style="@style/Row">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_clock" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/ride_time" style="@style/Body" android:text="17:45" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" />
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_user" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/ride_seats" style="@style/Caption" android:text="1 chỗ" android:layout_marginHorizontal="6dp" />
                        <TextView android:id="@+id/ride_price" style="@style/Badge" android:text="Miễn phí" android:background="@drawable/bg_price" android:textColor="@color/ink" />
                    </LinearLayout>
                    <LinearLayout style="@style/Row">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_pin" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/ride_pickup" style="@style/Caption" android:text="Đón tại cổng công viên" android:layout_marginStart="8dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/Card" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
                    <LinearLayout style="@style/Row">
                        <ImageView android:id="@+id/driver_avatar" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/avatar_3" android:contentDescription="Ảnh chủ xe" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:id="@+id/driver_name" style="@style/BodyBold" android:text="Hoàng Nam" />
                            <TextView android:id="@+id/driver_meta" style="@style/Caption" android:text="★ 4.7 · Yamaha Sirius" />
                        </LinearLayout>
                        <TextView android:id="@+id/verified_badge" style="@style/Badge" android:text="Đã xác minh" />
                    </LinearLayout>
                    <LinearLayout style="@style/Row">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_clock" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/ride_time" style="@style/Body" android:text="18:00" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" />
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_user" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/ride_seats" style="@style/Caption" android:text="1 chỗ" android:layout_marginHorizontal="6dp" />
                        <TextView android:id="@+id/ride_price" style="@style/Badge" android:text="20.000đ" android:background="@drawable/bg_price" android:textColor="@color/ink" />
                    </LinearLayout>
                    <LinearLayout style="@style/Row">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_pin" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/ride_pickup" style="@style/Caption" android:text="Đón tại cổng công viên" android:layout_marginStart="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView style="@style/Hint" android:text="Chọn một chuyến để xem thông tin chi tiết." />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/action_area" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="4dp" android:paddingBottom="12dp" android:background="@color/background" android:visibility="gone">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/primary_action" style="@style/ButtonPrimary" android:text="Tiếp tục" android:clickable="false" android:focusable="false" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/secondary_action" style="@style/ButtonSecondary" android:text="Quay lại" android:clickable="false" android:focusable="false" />
    </LinearLayout>
    <LinearLayout android:id="@+id/bottom_nav" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@color/white" android:elevation="6dp" android:visibility="visible">
        <LinearLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
            <ImageView android:id="@+id/nav_home_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_pin" android:importantForAccessibility="no" android:tint="@color/primary" />
            <TextView android:id="@+id/nav_home_label" style="@style/Caption" android:text="Tìm chuyến" android:layout_marginTop="5dp" android:layout_marginBottom="0dp" android:textColor="@color/primary" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_trips" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
            <ImageView android:id="@+id/nav_trips_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_calendar" android:importantForAccessibility="no" android:tint="@color/muted" />
            <TextView android:id="@+id/nav_trips_label" style="@style/Caption" android:text="Chuyến của tôi" android:layout_marginTop="5dp" android:layout_marginBottom="0dp" android:textColor="@color/muted" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_account" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
            <ImageView android:id="@+id/nav_account_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_user" android:importantForAccessibility="no" android:tint="@color/muted" />
            <TextView android:id="@+id/nav_account_label" style="@style/Caption" android:text="Tài khoản" android:layout_marginTop="5dp" android:layout_marginBottom="0dp" android:textColor="@color/muted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
