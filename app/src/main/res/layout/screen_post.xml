<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Phần tiêu đề của màn hình -->
    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/header_back"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại"
            android:visibility="visible" />

        <TextView
            android:id="@+id/header_title"
            style="@style/Subtitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="52dp"
            android:gravity="center"
            android:text="Đăng chuyến" />

        <ImageButton
            android:id="@+id/header_action"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|end"
            android:src="@drawable/ic_bell"
            android:contentDescription="Thông báo"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>

    <!-- Nội dung biểu mẫu có thể cuộn -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Subtitle"
                android:text="Chia sẻ chuyến đi của bạn" />

            <TextView
                style="@style/Hint"
                android:text="Kết nối với người có cùng tuyến đường." />

            <!-- Chọn điểm đi, điểm đến, ngày và giờ -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:id="@+id/post_start"
                    style="@style/Picker"
                    android:clickable="false"
                    android:focusable="false">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_pin"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            style="@style/Caption"
                            android:text="Điểm đi" />

                        <TextView
                            android:id="@+id/post_start_value"
                            style="@style/BodyBold"
                            android:text="Chọn điểm đi" />
                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/border" />

                <LinearLayout
                    android:id="@+id/post_end"
                    style="@style/Picker"
                    android:clickable="false"
                    android:focusable="false">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_pin"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            style="@style/Caption"
                            android:text="Điểm đến" />

                        <TextView
                            android:id="@+id/post_end_value"
                            style="@style/BodyBold"
                            android:text="Chọn điểm đến" />
                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/border" />

                <!-- Trường chọn ngày khởi hành -->
                <LinearLayout
                    android:id="@+id/post_date"
                    style="@style/Picker"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_calendar"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            style="@style/Caption"
                            android:text="Ngày khởi hành" />

                        <TextView
                            android:id="@+id/post_date_value"
                            style="@style/BodyBold"
                            android:text="Chọn ngày khởi hành" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <!-- Trường chọn giờ khởi hành -->
                <LinearLayout
                    android:id="@+id/post_time"
                    style="@style/Picker"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_clock"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            style="@style/Caption"
                            android:text="Giờ khởi hành" />

                        <TextView
                            android:id="@+id/post_time_value"
                            style="@style/BodyBold"
                            android:text="Chọn giờ khởi hành" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>

            <!-- Chi phí và ghi chú của chuyến -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/Caption"
                    android:text="Số chỗ đi nhờ" />

                <TextView
                    style="@style/BodyBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="1 người (cố định)" />

                <TextView
                    style="@style/Caption"
                    android:text="Đóng góp xăng xe (đ)" />

                <EditText
                    android:id="@+id/post_cost"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:singleLine="true"
                    android:hint="Nhập số tiền"
                    android:text=""
                    android:importantForAutofill="no" />

                <CheckBox
                    android:id="@+id/post_free"
                    style="@style/Radio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Miễn phí" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/border" />

                <TextView
                    style="@style/Caption"
                    android:text="Ghi chú chuyến đi (không bắt buộc)" />

                <EditText
                    android:id="@+id/post_note"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:hint="Nhập thông tin bổ sung cho chuyến đi"
                    android:text=""
                    android:importantForAutofill="no" />

            </LinearLayout>

            <TextView
                style="@style/Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="4dp"
                android:text="Thông tin xe sẽ được lấy từ hồ sơ của chủ xe." />

        </LinearLayout>
    </ScrollView>

    <!-- Các nút thao tác phía dưới -->
    <LinearLayout
        android:id="@+id/action_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:background="@color/background">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/primary_action"
            style="@style/ButtonPrimary"
            android:text="Kiểm tra thông tin chuyến" />

    </LinearLayout>

</LinearLayout>
