<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:descendantFocusability="blocksDescendants"
    android:importantForAccessibility="noHideDescendants">

    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="12dp"
        android:visibility="visible">

        <ImageButton
            android:id="@+id/header_back"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại"
            android:visibility="visible"
            android:clickable="false"
            android:focusable="false" />

        <TextView
            android:id="@+id/header_title"
            style="@style/Subtitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="52dp"
            android:layout_marginBottom="0dp"
            android:gravity="center"
            android:text="Yêu cầu bị từ chối" />

        <ImageButton
            android:id="@+id/header_action"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|end"
            android:src="@drawable/ic_bell"
            android:contentDescription="Thông báo"
            android:visibility="visible"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="24dp">

                <ImageView
                    android:id="@+id/status_icon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:padding="20dp"
                    android:background="@drawable/bg_avatar"
                    android:src="@drawable/ic_close"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/status_title"
                    style="@style/Subtitle"
                    android:text="Chưa thể tham gia chuyến"
                    android:textColor="@color/primary"
                    android:gravity="center"
                    android:layout_marginTop="18dp" />

                <TextView
                    android:id="@+id/status_description"
                    style="@style/Body"
                    android:text="Chủ xe đã từ chối yêu cầu của bạn."
                    android:gravity="center"
                    android:textColor="@color/muted" />
            </LinearLayout>

            <include layout="@layout/view_trip_summary" />

            <include layout="@layout/view_map" />

            <LinearLayout
                style="@style/Card"
                android:background="@drawable/bg_lavender">

                <TextView
                    style="@style/BodyBold"
                    android:text="Vẫn còn chuyến phù hợp khác" />

                <TextView
                    style="@style/Hint"
                    android:text="Thử tìm chuyến gần giờ bạn muốn đi." />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/action_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:background="@color/background"
        android:visibility="visible">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/primary_action"
            style="@style/ButtonPrimary"
            android:text="Tìm chuyến khác"
            android:clickable="false"
            android:focusable="false" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/secondary_action"
            style="@style/ButtonSecondary"
            android:text="Quay lại"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_pin"
                android:importantForAccessibility="no"
                app:tint="@color/primary" />
            <TextView android:id="@+id/nav_home_label" style="@style/Caption" android:text="Tìm chuyến" android:layout_marginTop="5dp" android:layout_marginBottom="0dp" android:textColor="@color/primary" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_trips" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
            <ImageView android:id="@+id/nav_trips_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_calendar" android:importantForAccessibility="no"
                app:tint="@color/muted" />
            <TextView android:id="@+id/nav_trips_label" style="@style/Caption" android:text="Chuyến của tôi" android:layout_marginTop="5dp" android:layout_marginBottom="0dp" android:textColor="@color/muted" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_account" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
            <ImageView android:id="@+id/nav_account_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_user" android:importantForAccessibility="no"
                app:tint="@color/muted" />
            <TextView android:id="@+id/nav_account_label" style="@style/Caption" android:text="Tài khoản" android:layout_marginTop="5dp" android:layout_marginBottom="0dp" android:textColor="@color/muted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

