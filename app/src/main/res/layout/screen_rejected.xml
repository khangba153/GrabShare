<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/screen_header_height"
        android:paddingHorizontal="12dp"
        android:visibility="visible">
        <ImageButton
            android:id="@+id/header_back"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại"
            android:visibility="visible"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/header_title"
            style="@style/Subtitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="104dp"
            android:layout_marginBottom="0dp"
            android:gravity="center"
            android:text="Yêu cầu bị từ chối"
            android:maxLines="1"
            android:ellipsize="end" />
        <ImageButton
            android:id="@+id/header_chat"
            style="@style/IconButton"
            android:src="@drawable/ic_chat"
            android:contentDescription="Tin nhắn"
            android:visibility="gone"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="48dp" />
        <ImageButton
            android:id="@+id/header_action"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|end"
            android:src="@drawable/ic_bell"
            android:contentDescription="Thông báo"
            android:visibility="visible"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:layout_weight="1"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="12dp">
                <ImageView
                    android:id="@+id/status_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_avatar"
                    android:src="@drawable/ic_close"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/status_title"
                    style="@style/Subtitle"
                    android:text="Chưa thể tham gia chuyến"
                    android:textColor="@color/primary"
                    android:gravity="center"
                    android:layout_marginTop="10dp" />
                <TextView
                    android:id="@+id/status_description"
                    style="@style/Body"
                    android:text="Chủ xe đã từ chối yêu cầu của bạn."
                    android:gravity="center"
                    android:textColor="@color/muted" />
            </LinearLayout>
            <include
                layout="@layout/view_trip_summary" />
            <TextView
                android:id="@+id/passenger_route_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Điểm khách: Đang tải…"
                android:textColor="@color/primary" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:tag="ui_section:screen_rejected_driver_route"
                android:layout_marginBottom="12dp">
                <TextView
                    style="@style/BodyBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="Tuyến đầy đủ của chủ xe"
                    android:textColor="@color/primary"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
                <include
                    layout="@layout/view_map" />
            </LinearLayout>
            <LinearLayout
                style="@style/Card"
                android:background="@drawable/bg_lavender">
                <TextView
                    style="@style/BodyBold"
                    android:text="Vẫn còn chuyến phù hợp khác" />
                <TextView
                    style="@style/Hint"
                    android:text="Thử tìm chuyến gần giờ bạn muốn đi." />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/action_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:background="@color/background"
                android:visibility="visible">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/primary_action"
                    style="@style/ButtonPrimary"
                    android:text="Tìm chuyến khác"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/secondary_action"
                    style="@style/ButtonSecondary"
                    android:text="Quay lại"
                    android:visibility="gone"
                    android:clickable="false"
                    android:focusable="false"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="6dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_pin"
                android:importantForAccessibility="no"
                app:tint="@color/primary" />
            <TextView
                android:id="@+id/nav_home_label"
                style="@style/Caption"
                android:text="Tìm chuyến"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="0dp"
                android:textColor="@color/primary" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_trips"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/nav_trips_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar"
                android:importantForAccessibility="no"
                app:tint="@color/muted" />
            <TextView
                android:id="@+id/nav_trips_label"
                style="@style/Caption"
                android:text="Chuyến của tôi"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="0dp"
                android:textColor="@color/muted" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_account"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/nav_account_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_user"
                android:importantForAccessibility="no"
                app:tint="@color/muted" />
            <TextView
                android:id="@+id/nav_account_label"
                style="@style/Caption"
                android:text="Tài khoản"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="0dp"
                android:textColor="@color/muted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
