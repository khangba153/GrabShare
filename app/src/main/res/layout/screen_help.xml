<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <!-- Nội dung tĩnh, không cần Auth hoặc kết nối mạng. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="12dp">
        <ImageButton
            android:id="@+id/header_back"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại" />
        <TextView
            style="@style/Subtitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="52dp"
            android:gravity="center"
            android:text="@string/account_help_title" />
    </FrameLayout>
    <ScrollView
        android:id="@+id/help_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                style="@style/Title"
                android:text="Đi cùng GrabShare" />
            <TextView
                style="@style/Body"
                android:text="@string/account_help_intro" />
            <LinearLayout
                style="@style/Card">
                <TextView
                    style="@style/Subtitle"
                    android:text="@string/account_help_passenger_title" />
                <TextView
                    style="@style/Body"
                    android:text="@string/account_help_passenger" />
            </LinearLayout>
            <LinearLayout
                style="@style/Card">
                <TextView
                    style="@style/Subtitle"
                    android:text="@string/account_help_driver_title" />
                <TextView
                    style="@style/Body"
                    android:text="@string/account_help_driver" />
            </LinearLayout>
            <LinearLayout
                style="@style/Card">
                <TextView
                    style="@style/Subtitle"
                    android:text="@string/account_help_profile_title" />
                <TextView
                    style="@style/Body"
                    android:text="@string/account_help_profile" />
            </LinearLayout>
            <LinearLayout
                style="@style/Card">
                <TextView
                    style="@style/Subtitle"
                    android:text="@string/account_help_safety_title" />
                <TextView
                    style="@style/Body"
                    android:text="@string/account_help_safety" />
            </LinearLayout>
            <LinearLayout
                style="@style/Card">
                <TextView
                    style="@style/Subtitle"
                    android:text="@string/account_help_problem_title" />
                <TextView
                    style="@style/Body"
                    android:text="@string/account_help_problem" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/help_terms"
                style="@style/ButtonSecondary"
                android:text="@string/account_terms_title" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
