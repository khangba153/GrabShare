<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/screen_header_height"
        android:paddingHorizontal="12dp"
        android:visibility="visible">
        <ImageButton
            android:id="@+id/header_back"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại"
            android:visibility="visible"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/header_title"
            style="@style/Subtitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="104dp"
            android:layout_marginBottom="0dp"
            android:gravity="center"
            android:text="Hoàn thành &amp; đánh giá"
            android:maxLines="1"
            android:ellipsize="end" />
        <ImageButton
            android:id="@+id/header_chat"
            style="@style/IconButton"
            android:src="@drawable/ic_chat"
            android:contentDescription="Tin nhắn"
            android:visibility="gone"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="48dp" />
        <ImageButton
            android:id="@+id/header_action"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|end"
            android:src="@drawable/ic_bell"
            android:contentDescription="Thông báo"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/chat_open"
        style="@style/ButtonSecondary"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:text="Nhắn tin"
        android:visibility="gone" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:layout_weight="1"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="12dp">
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_check"
                    android:importantForAccessibility="no" />
                <TextView
                    style="@style/Subtitle"
                    android:text="Chuyến đi đã hoàn thành"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/primary" />
                <TextView
                    style="@style/Hint"
                    android:text="Cảm ơn bạn đã chia sẻ hành trình!" />
            </LinearLayout>
            <include
                layout="@layout/view_trip_summary" />
            <include
                layout="@layout/view_ride_progress_guidance" />
            <TextView
                android:id="@+id/passenger_route_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Điểm khách: Đang tải…"
                android:textColor="@color/primary" />
            <LinearLayout
                style="@style/Card">
                <TextView
                    style="@style/Subtitle"
                    android:text="Bạn thấy chuyến đi thế nào?" />
                <TextView
                    android:id="@+id/rating_status"
                    style="@style/Caption"
                    android:text="Đang xác nhận đánh giá…"
                    android:accessibilityLiveRegion="polite" />
                <Button
                    android:id="@+id/rating_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thử đọc lại"
                    android:visibility="gone" />
                <RatingBar
                    android:id="@+id/rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:rating="5"
                    android:stepSize="1"
                    android:progressTint="@color/amber"
                    android:layout_gravity="center"
                    android:isIndicator="true" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        style="@style/Caption"
                        android:text="Nhận xét (không bắt buộc)" />
                    <EditText
                        android:id="@+id/rating_comment"
                        style="@style/Input"
                        android:inputType="textCapSentences|textMultiLine"
                        android:hint="Chia sẻ cảm nhận về chuyến đi…"
                        android:importantForAutofill="no"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/rating_comment_counter"
                        style="@style/Caption"
                        android:text="0/500 ký tự"
                        android:labelFor="@id/rating_comment" />
                </LinearLayout>
                <TextView
                    style="@style/Caption"
                    android:text="Đúng giờ · Thân thiện · Lái xe an toàn" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                style="@style/ButtonSecondary"
                android:id="@+id/completed_favorite"
                android:text="Yêu thích chuyến đã đi"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
            <TextView
                style="@style/Caption"
                android:id="@+id/completed_favorite_status"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite" />
            <TextView
                style="@style/Hint"
                android:text="Khoản đóng góp là thông tin đã xác nhận cho chuyến; trạng thái hoàn thành không xác nhận đã thanh toán." />
            <LinearLayout
                android:id="@+id/action_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:background="@color/background"
                android:visibility="visible">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/primary_action"
                    style="@style/ButtonPrimary"
                    android:text="Gửi đánh giá"
                    android:enabled="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/secondary_action"
                    style="@style/ButtonSecondary"
                    android:text="Quay lại"
                    android:visibility="gone"
                    android:clickable="false"
                    android:focusable="false"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="6dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_pin"
                android:importantForAccessibility="no"
                android:tint="@color/primary" />
            <TextView
                android:id="@+id/nav_home_label"
                style="@style/Caption"
                android:text="Tìm chuyến"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="0dp"
                android:textColor="@color/primary" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_trips"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/nav_trips_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar"
                android:importantForAccessibility="no"
                android:tint="@color/muted" />
            <TextView
                android:id="@+id/nav_trips_label"
                style="@style/Caption"
                android:text="Chuyến của tôi"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="0dp"
                android:textColor="@color/muted" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_account"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/nav_account_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_user"
                android:importantForAccessibility="no"
                android:tint="@color/muted" />
            <TextView
                android:id="@+id/nav_account_label"
                style="@style/Caption"
                android:text="Tài khoản"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="0dp"
                android:textColor="@color/muted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
