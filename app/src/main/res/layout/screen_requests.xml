<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/screen_header_height"
        android:paddingHorizontal="12dp"
        android:visibility="visible">
        <ImageButton
            android:id="@+id/header_back"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại"
            android:visibility="visible"
            android:clickable="false"
            android:focusable="false" />
        <TextView
            android:id="@+id/header_title"
            style="@style/Subtitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="104dp"
            android:layout_marginBottom="0dp"
            android:gravity="center"
            android:text="Yêu cầu đi nhờ"
            android:maxLines="1"
            android:ellipsize="end" />
        <ImageButton
            android:id="@+id/header_chat"
            style="@style/IconButton"
            android:src="@drawable/ic_chat"
            android:contentDescription="Tin nhắn"
            android:visibility="gone"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="48dp" />
        <ImageButton
            android:id="@+id/header_action"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|end"
            android:src="@drawable/ic_bell"
            android:contentDescription="Thông báo"
            android:visibility="visible"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:layout_weight="1"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">
            <LinearLayout
                style="@style/Card">
                <include
                    layout="@layout/view_route" />
                <TextView
                    android:id="@+id/requests_summary"
                    style="@style/Caption"
                    android:text="Đang tải chuyến…" />
            </LinearLayout>
            <LinearLayout
                style="@style/Row">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/requests_pending"
                    style="@style/ButtonPrimary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:text="Chờ duyệt"
                    android:clickable="false"
                    android:focusable="false"
                    android:minHeight="48dp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/requests_accepted"
                    style="@style/ButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:text="Đã nhận"
                    android:clickable="false"
                    android:focusable="false"
                    android:minHeight="48dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/request_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView
                style="@style/Hint"
                android:text="Chỉ nhận tối đa 1 người đi nhờ cho chuyến xe máy." />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/action_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:background="@color/background"
        android:visibility="gone">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/primary_action"
            style="@style/ButtonPrimary"
            android:text="Tiếp tục"
            android:clickable="false"
            android:focusable="false"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/secondary_action"
            style="@style/ButtonSecondary"
            android:text="Quay lại"
            android:clickable="false"
            android:focusable="false"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="6dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_pin"
                android:importantForAccessibility="no"
                android:tint="@color/primary" />
            <TextView
                android:id="@+id/nav_home_label"
                style="@style/Caption"
                android:text="Tìm chuyến"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="0dp"
                android:textColor="@color/primary" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_trips"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/nav_trips_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar"
                android:importantForAccessibility="no"
                android:tint="@color/muted" />
            <TextView
                android:id="@+id/nav_trips_label"
                style="@style/Caption"
                android:text="Chuyến của tôi"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="0dp"
                android:textColor="@color/muted" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_account"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/nav_account_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_user"
                android:importantForAccessibility="no"
                android:tint="@color/muted" />
            <TextView
                android:id="@+id/nav_account_label"
                style="@style/Caption"
                android:text="Tài khoản"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="0dp"
                android:textColor="@color/muted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
