<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Card">
    <TextView
        android:id="@+id/driver_name"
        style="@style/BodyBold"
        android:text="Đang tải chủ xe…" />
    <TextView
        android:id="@+id/driver_meta"
        style="@style/Caption" />
    <TextView
        android:id="@+id/trip_time"
        style="@style/Caption" />
    <TextView
        style="@style/Caption"
        android:layout_marginTop="12dp"
        android:text="Đón bạn" />
    <TextView
        android:id="@+id/route_start"
        style="@style/BodyBold"
        android:maxLines="2"
        android:ellipsize="end" />
    <TextView
        style="@style/Caption"
        android:layout_marginTop="8dp"
        android:text="Trả bạn" />
    <TextView
        android:id="@+id/route_end"
        style="@style/BodyBold"
        android:maxLines="2"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/passenger_route_toggle"
        style="@style/Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:textColor="@color/primary"
        android:background="?attr/selectableItemBackground"
        android:text="Xem địa chỉ đầy đủ" />
    <TextView
        android:id="@+id/passenger_route_summary"
        style="@style/Body"
        android:visibility="gone"
        android:textIsSelectable="true" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/border" />
    <TextView
        style="@style/Caption"
        android:text="Khoản bạn đã xác nhận" />
    <TextView
        android:id="@+id/trip_cost"
        style="@style/BodyBold"
        android:textColor="@color/primary"
        android:textSize="22sp" />
</LinearLayout>
