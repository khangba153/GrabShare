<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background" android:descendantFocusability="blocksDescendants" android:importantForAccessibility="noHideDescendants">
    <FrameLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="64dp" android:paddingHorizontal="12dp" android:visibility="visible">
        <ImageButton android:id="@+id/header_back" style="@style/IconButton" android:layout_gravity="center_vertical|start" android:src="@drawable/ic_back" android:contentDescription="Quay lại" android:visibility="visible" android:clickable="false" android:focusable="false" />
        <TextView android:id="@+id/header_title" style="@style/Subtitle" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginHorizontal="52dp" android:layout_marginBottom="0dp" android:gravity="center" android:text="Đăng ký" />
        <ImageButton android:id="@+id/header_action" style="@style/IconButton" android:layout_gravity="center_vertical|end" android:src="@drawable/ic_bell" android:contentDescription="Thông báo" android:visibility="invisible" android:clickable="false" android:focusable="false" />
    </FrameLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:fillViewport="true" android:clipToPadding="false" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="8dp" android:paddingBottom="24dp">
            <TextView style="@style/Title" android:text="Tạo tài khoản" />
            <TextView style="@style/Hint" android:text="Cùng cộng đồng chia sẻ những hành trình." />
            <LinearLayout style="@style/Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                    <TextView style="@style/Caption" android:text="Họ và tên" />
                    <EditText android:id="@+id/register_name" style="@style/Input" android:inputType="textPersonName" android:hint="Tên hiển thị của bạn" android:importantForAutofill="no" android:focusable="false" android:focusableInTouchMode="false" android:cursorVisible="false" android:longClickable="false" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                    <TextView style="@style/Caption" android:text="Email" />
                    <EditText android:id="@+id/register_email" style="@style/Input" android:inputType="textEmailAddress" android:hint="Email" android:importantForAutofill="no" android:focusable="false" android:focusableInTouchMode="false" android:cursorVisible="false" android:longClickable="false" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                    <TextView style="@style/Caption" android:text="Số điện thoại" />
                    <EditText android:id="@+id/register_phone" style="@style/Input" android:inputType="phone" android:hint="Số điện thoại" android:importantForAutofill="no" android:focusable="false" android:focusableInTouchMode="false" android:cursorVisible="false" android:longClickable="false" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                    <TextView style="@style/Caption" android:text="Mật khẩu" />
                    <EditText android:id="@+id/register_password" style="@style/Input" android:inputType="textPassword" android:hint="Mật khẩu" android:importantForAutofill="no" android:focusable="false" android:focusableInTouchMode="false" android:cursorVisible="false" android:longClickable="false" />
                </LinearLayout>
                <CheckBox android:id="@+id/register_terms" style="@style/Radio" android:text="Tôi đồng ý với Điều khoản sử dụng" android:checked="true" android:clickable="false" android:focusable="false" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/open_terms" style="@style/ButtonSecondary" android:text="Xem điều khoản sử dụng" android:clickable="false" android:focusable="false" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/register_submit" style="@style/ButtonPrimary" android:text="Đăng ký" android:clickable="false" android:focusable="false" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/go_login" style="@style/ButtonSecondary" android:text="Đã có tài khoản? Đăng nhập" android:clickable="false" android:focusable="false" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/action_area" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="4dp" android:paddingBottom="12dp" android:background="@color/background" android:visibility="gone">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/primary_action" style="@style/ButtonPrimary" android:text="Tiếp tục" android:clickable="false" android:focusable="false" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/secondary_action" style="@style/ButtonSecondary" android:text="Quay lại" android:clickable="false" android:focusable="false" />
    </LinearLayout>
    <LinearLayout android:id="@+id/bottom_nav" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@color/white" android:elevation="6dp" android:visibility="gone">
        <LinearLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
            <ImageView android:id="@+id/nav_home_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_pin" android:importantForAccessibility="no" android:tint="@color/primary" />
            <TextView android:id="@+id/nav_home_label" style="@style/Caption" android:text="Tìm chuyến" android:layout_marginTop="5dp" android:layout_marginBottom="0dp" android:textColor="@color/primary" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_trips" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
            <ImageView android:id="@+id/nav_trips_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_calendar" android:importantForAccessibility="no" android:tint="@color/muted" />
            <TextView android:id="@+id/nav_trips_label" style="@style/Caption" android:text="Chuyến của tôi" android:layout_marginTop="5dp" android:layout_marginBottom="0dp" android:textColor="@color/muted" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_account" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
            <ImageView android:id="@+id/nav_account_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_user" android:importantForAccessibility="no" android:tint="@color/muted" />
            <TextView android:id="@+id/nav_account_label" style="@style/Caption" android:text="Tài khoản" android:layout_marginTop="5dp" android:layout_marginBottom="0dp" android:textColor="@color/muted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
