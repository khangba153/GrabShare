<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/header_back"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            style="@style/Subtitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="52dp"
            android:gravity="center"
            android:text="Quản lý chuyến" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/manage_loading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/manage_status"
                style="@style/Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang tải..." />

            <TextView
                android:id="@+id/manage_time"
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Đang tải thời gian..." />

            <TextView
                android:id="@+id/manage_message"
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Đang tải thông tin chuyến..."
                android:visibility="visible" />

            <include layout="@layout/view_map" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thông tin chuyến" />

                <LinearLayout
                    style="@style/Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chỗ còn lại" />

                    <TextView
                        android:id="@+id/remaining_seats"
                        style="@style/BodyBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang tải..." />
                </LinearLayout>

                <LinearLayout
                    style="@style/Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <TextView
                        style="@style/Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Đóng góp" />

                    <TextView
                        android:id="@+id/manage_cost"
                        style="@style/BodyBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang tải..." />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/border" />

                <TextView
                    style="@style/Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ghi chú" />

                <TextView
                    android:id="@+id/manage_note"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Đang tải..." />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/manage_edit"
                style="@style/ButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chỉnh sửa chuyến"
                android:enabled="false" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/manage_requests"
                style="@style/ButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Yêu cầu đi nhờ"
                android:enabled="false" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/action_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:background="@color/background">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/primary_action"
            style="@style/ButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hoàn thành chuyến"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/secondary_action"
            style="@style/ButtonSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hủy chuyến"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
