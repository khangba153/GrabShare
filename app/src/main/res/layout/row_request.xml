<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Card"
    android:foreground="?attr/selectableItemBackground">
    <include
        layout="@layout/view_driver" />
    <LinearLayout
        style="@style/Row">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_user"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/request_pickup"
            style="@style/Caption"
            android:text="1 người · Cổng công viên"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/request_dropoff"
        style="@style/Body"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/request_contribution"
        style="@style/BodyBold"
        android:textColor="@color/primary" />
    <TextView
        android:id="@+id/request_card_status"
        style="@style/Caption" />
    <TextView
        android:id="@+id/request_message"
        style="@style/Body"
        android:visibility="gone" />
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/request_open"
        style="@style/ButtonSecondary"
        android:text="Xem yêu cầu"
        android:visibility="gone"
        android:layout_height="wrap_content"
        android:minHeight="48dp" />
</LinearLayout>
