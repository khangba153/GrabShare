<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="12dp">
        <ImageButton
            android:id="@+id/header_back"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại" />
        <TextView
            android:id="@+id/header_title"
            style="@style/Subtitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="52dp"
            android:gravity="center"
            android:text="Chuyến của tôi" />
        <ImageButton
            android:id="@+id/header_action"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|end"
            android:src="@drawable/ic_bell"
            android:contentDescription="Thông báo"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <LinearLayout style="@style/Row">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/role_passenger"
                    style="@style/ButtonPrimary"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:text="Đi nhờ" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/role_driver"
                    style="@style/ButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:text="Chủ xe" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tab_upcoming"
                    style="@style/ButtonPrimary"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:text="Sắp đi" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tab_pending"
                    style="@style/ButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:text="Chờ duyệt" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tab_history"
                    style="@style/ButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:text="Lịch sử" />
            </LinearLayout>

            <TextView
                android:id="@+id/trip_data_note"
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_lavender"
                android:padding="10dp"
                android:text="Đang hiển thị dữ liệu đã lưu trên thiết bị; chưa xác nhận trạng thái mới nhất."
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="28dp">
                <ProgressBar
                    android:id="@+id/trip_loading_progress"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminate="true" />
                <TextView
                    android:id="@+id/trip_loading"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Đang tải chuyến đi nhờ..." />
                <TextView
                    android:id="@+id/trip_empty"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Bạn chưa có yêu cầu đi nhờ nào."
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/trip_error"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/coral"
                    android:text="Không tải được danh sách chuyến."
                    android:visibility="gone" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/trip_retry"
                    style="@style/ButtonSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Thử tải lại"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/trip_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/action_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:background="@color/background"
        android:visibility="gone">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/primary_action"
            style="@style/ButtonPrimary"
            android:text="Tiếp tục" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/secondary_action"
            style="@style/ButtonSecondary"
            android:text="Quay lại" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="6dp">
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_pin"
                android:importantForAccessibility="no"
                android:tint="@color/muted" />
            <TextView
                android:id="@+id/nav_home_label"
                style="@style/Caption"
                android:layout_marginTop="5dp"
                android:text="Tìm chuyến"
                android:textColor="@color/muted" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_trips"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/nav_trips_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar"
                android:importantForAccessibility="no"
                android:tint="@color/primary" />
            <TextView
                android:id="@+id/nav_trips_label"
                style="@style/Caption"
                android:layout_marginTop="5dp"
                android:text="Chuyến của tôi"
                android:textColor="@color/primary" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_account"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/nav_account_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_user"
                android:importantForAccessibility="no"
                android:tint="@color/muted" />
            <TextView
                android:id="@+id/nav_account_label"
                style="@style/Caption"
                android:layout_marginTop="5dp"
                android:text="Tài khoản"
                android:textColor="@color/muted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
