<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="12dp">
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginHorizontal="52dp"
            android:text="Chuyến của tôi"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/ink"
            android:maxLines="1"
            android:ellipsize="end" />
        <ImageButton
            android:id="@+id/header_action"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|end"
            android:src="@drawable/ic_bell"
            android:contentDescription="Thông báo" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/role_passenger"
            style="@style/ButtonPrimary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Đi nhờ"
            android:layout_marginTop="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/role_driver"
            style="@style/ButtonSecondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Chủ xe"
            android:layout_marginTop="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tab_upcoming"
            style="@style/ButtonPrimary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:layout_marginTop="0dp"
            android:text="Đang theo dõi"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tab_history"
            style="@style/ButtonSecondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:layout_marginTop="0dp"
            android:text="Lịch sử"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
        <androidx.appcompat.widget.AppCompatButton
            style="@style/ButtonSecondary"
            android:id="@+id/trip_list_filter"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Bộ lọc"
            android:layout_marginHorizontal="3dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="8dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_my_trips"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tv_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Bạn chưa có chuyến đi nhờ nào"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/layout_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Không thể tải dữ liệu. Vui lòng thử lại."
                android:textColor="#EF4444"
                android:textSize="15sp"
                android:layout_marginBottom="12dp" />
            <Button
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thử lại" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="6dp">
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_pin"
                android:tint="@color/muted"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/Caption"
                android:text="Tìm chuyến"
                android:textColor="@color/muted"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="0dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_trips"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:importantForAccessibility="yes"
            android:contentDescription="Chuyến của tôi, đang chọn">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar"
                android:tint="@color/primary"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/Caption"
                android:text="Chuyến của tôi"
                android:textColor="@color/primary"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="0dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_account"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_user"
                android:tint="@color/muted"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/Caption"
                android:text="Tài khoản"
                android:textColor="@color/muted"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="0dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
