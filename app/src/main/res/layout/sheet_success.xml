<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_sheet" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <View android:layout_width="36dp" android:layout_height="4dp" android:layout_gravity="center" android:background="@color/border" android:layout_marginBottom="20dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_mail" android:importantForAccessibility="no" />
            <TextView style="@style/Subtitle" android:text="Kiểm tra email của bạn" android:gravity="center" android:layout_marginTop="20dp" />
            <TextView style="@style/Body" android:text="Nếu email này đã được đăng ký, bạn sẽ nhận được liên kết đặt lại mật khẩu." android:gravity="center" />
        </LinearLayout>
        <TextView android:id="@+id/recovery_address" style="@style/Badge" android:text="ngocanh@example.com" android:layout_marginTop="16dp" android:layout_gravity="center" />
        <TextView style="@style/Hint" android:text="Đây là trạng thái minh họa; không gửi email thật." />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/sheet_submit" style="@style/ButtonPrimary" android:text="Về đăng nhập" android:clickable="false" android:focusable="false" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/preview_reset" style="@style/ButtonSecondary" android:text="Xem biểu mẫu mật khẩu mới" android:clickable="false" android:focusable="false" />
    </LinearLayout>
</ScrollView>
