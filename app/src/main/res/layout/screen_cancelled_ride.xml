<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">
        <ImageButton
            android:id="@+id/header_back"
            style="@style/IconButton"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại" />
        <TextView
            style="@style/Subtitle"
            android:text="Chi tiết lịch sử"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end" />
        <ImageButton
            android:id="@+id/header_action"
            style="@style/IconButton"
            android:src="@drawable/ic_bell"
            android:contentDescription="Thông báo" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/history_status"
                style="@style/AccountFeedback" />
            <TextView
                android:id="@+id/history_details"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:textIsSelectable="true" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/history_retry"
                style="@style/ButtonSecondary"
                android:text="Thử lại"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
