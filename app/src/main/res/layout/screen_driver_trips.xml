<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/screen_header_height"
        android:paddingHorizontal="12dp">
        <ImageButton
            android:id="@+id/header_back"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại"
            android:visibility="invisible"
            android:clickable="false"
            android:focusable="false" />
        <TextView
            android:id="@+id/header_title"
            style="@style/Subtitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="104dp"
            android:gravity="center"
            android:text="Chuyến của tôi"
            android:maxLines="1"
            android:ellipsize="end" />
        <ImageButton
            android:id="@+id/header_chat"
            style="@style/IconButton"
            android:src="@drawable/ic_chat"
            android:contentDescription="Tin nhắn"
            android:visibility="gone"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="48dp" />
        <ImageButton
            android:id="@+id/header_action"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|end"
            android:src="@drawable/ic_bell"
            android:contentDescription="Thông báo"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>
    <LinearLayout
        style="@style/Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/role_passenger"
            style="@style/ButtonSecondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginHorizontal="3dp"
            android:text="Đi nhờ"
            android:clickable="false"
            android:focusable="false"
            android:layout_marginTop="0dp" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/role_driver"
            style="@style/ButtonPrimary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginHorizontal="3dp"
            android:text="Chủ xe"
            android:clickable="false"
            android:focusable="false"
            android:layout_marginTop="0dp" />
    </LinearLayout>
    <LinearLayout
        style="@style/Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tab_upcoming"
            style="@style/ButtonPrimary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginHorizontal="3dp"
            android:text="Đang quản lý"
            android:layout_marginTop="0dp" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tab_history"
            style="@style/ButtonSecondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginHorizontal="3dp"
            android:text="Lịch sử"
            android:layout_marginTop="0dp" />
        <androidx.appcompat.widget.AppCompatButton
            style="@style/ButtonSecondary"
            android:id="@+id/trip_list_filter"
            android:text="Bộ lọc"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/trip_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/trip_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
        <TextView
            android:id="@+id/trip_message"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textAlignment="center"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />
    </FrameLayout>
    <LinearLayout
        android:id="@+id/action_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:background="@color/background">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/primary_action"
            style="@style/ButtonPrimary"
            android:text="＋ Đăng chuyến"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="6dp">
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_pin"
                android:importantForAccessibility="no"
                app:tint="@color/muted" />
            <TextView
                style="@style/Caption"
                android:text="Tìm chuyến"
                android:layout_marginTop="5dp"
                android:textColor="@color/muted" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_trips"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar"
                android:importantForAccessibility="no"
                app:tint="@color/primary" />
            <TextView
                style="@style/Caption"
                android:text="Chuyến của tôi"
                android:layout_marginTop="5dp"
                android:textColor="@color/primary" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_account"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_user"
                android:importantForAccessibility="no"
                app:tint="@color/muted" />
            <TextView
                style="@style/Caption"
                android:text="Tài khoản"
                android:layout_marginTop="5dp"
                android:textColor="@color/muted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
