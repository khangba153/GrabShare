<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background" android:descendantFocusability="blocksDescendants" android:importantForAccessibility="noHideDescendants">
    <FrameLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="64dp" android:paddingHorizontal="12dp" android:visibility="visible">
        <ImageButton android:id="@+id/header_back" style="@style/IconButton" android:layout_gravity="center_vertical|start" android:src="@drawable/ic_back" android:contentDescription="Quay lại" android:visibility="invisible" android:clickable="false" android:focusable="false" />
        <TextView android:id="@+id/header_title" style="@style/Subtitle" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginHorizontal="52dp" android:layout_marginBottom="0dp" android:gravity="center" android:text="Chuyến của tôi" />
        <ImageButton android:id="@+id/header_action" style="@style/IconButton" android:layout_gravity="center_vertical|end" android:src="@drawable/ic_bell" android:contentDescription="Thông báo" android:visibility="visible" android:clickable="false" android:focusable="false" />
    </FrameLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:fillViewport="true" android:clipToPadding="false" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="8dp" android:paddingBottom="24dp">
            <LinearLayout style="@style/Row">
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/role_passenger" style="@style/ButtonSecondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginHorizontal="3dp" android:text="Đi nhờ" android:clickable="false" android:focusable="false" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/role_driver" style="@style/ButtonPrimary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginHorizontal="3dp" android:text="Chủ xe" android:clickable="false" android:focusable="false" />
            </LinearLayout>
            <LinearLayout style="@style/Row">
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/tab_upcoming" style="@style/ButtonPrimary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginHorizontal="3dp" android:text="Sắp đi" android:clickable="false" android:focusable="false" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/tab_history" style="@style/ButtonSecondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginHorizontal="3dp" android:text="Lịch sử" android:clickable="false" android:focusable="false" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/trip_list">
                <LinearLayout style="@style/Card" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
                    <LinearLayout style="@style/Row">
                        <ImageView android:id="@+id/driver_avatar" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/avatar_2" android:contentDescription="Ảnh chủ xe" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:id="@+id/driver_name" style="@style/BodyBold" android:text="Ngọc Anh" />
                            <TextView android:id="@+id/driver_meta" style="@style/Caption" android:text="★ 4.8 · Honda Wave" />
                        </LinearLayout>
                        <TextView android:id="@+id/verified_badge" style="@style/Badge" android:text="Đã xác minh" />
                    </LinearLayout>
                    <include layout="@layout/view_route" />
                    <LinearLayout style="@style/Row">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_clock" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/trip_time" style="@style/Caption" android:text="Hôm nay · 17:30" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" />
                        <TextView android:id="@+id/trip_cost" style="@style/Badge" android:text="15.000đ" />
                    </LinearLayout>
                    <TextView android:id="@+id/trip_status" style="@style/Badge" android:text="2 yêu cầu chờ duyệt" />
                </LinearLayout>
                <LinearLayout style="@style/Card" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
                    <LinearLayout style="@style/Row">
                        <ImageView android:id="@+id/driver_avatar" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/avatar_2" android:contentDescription="Ảnh chủ xe" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:id="@+id/driver_name" style="@style/BodyBold" android:text="Ngọc Anh" />
                            <TextView android:id="@+id/driver_meta" style="@style/Caption" android:text="★ 4.8 · Honda Wave" />
                        </LinearLayout>
                        <TextView android:id="@+id/verified_badge" style="@style/Badge" android:text="Đã xác minh" />
                    </LinearLayout>
                    <include layout="@layout/view_route" />
                    <LinearLayout style="@style/Row">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_clock" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/trip_time" style="@style/Caption" android:text="Hôm nay · 17:45" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" />
                        <TextView android:id="@+id/trip_cost" style="@style/Badge" android:text="Miễn phí" />
                    </LinearLayout>
                    <TextView android:id="@+id/trip_status" style="@style/Badge" android:text="Đã có người đi cùng" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/action_area" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="4dp" android:paddingBottom="12dp" android:background="@color/background" android:visibility="visible">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/primary_action" style="@style/ButtonPrimary" android:text="＋ Đăng chuyến" android:clickable="false" android:focusable="false" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/secondary_action" style="@style/ButtonSecondary" android:text="Quay lại" android:visibility="gone" android:clickable="false" android:focusable="false" />
    </LinearLayout>
    <LinearLayout android:id="@+id/bottom_nav" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@color/white" android:elevation="6dp" android:visibility="visible">
        <LinearLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
            <ImageView android:id="@+id/nav_home_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_pin" android:importantForAccessibility="no" android:tint="@color/muted" />
            <TextView android:id="@+id/nav_home_label" style="@style/Caption" android:text="Tìm chuyến" android:layout_marginTop="5dp" android:layout_marginBottom="0dp" android:textColor="@color/muted" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_trips" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
            <ImageView android:id="@+id/nav_trips_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_calendar" android:importantForAccessibility="no" android:tint="@color/primary" />
            <TextView android:id="@+id/nav_trips_label" style="@style/Caption" android:text="Chuyến của tôi" android:layout_marginTop="5dp" android:layout_marginBottom="0dp" android:textColor="@color/primary" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_account" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="false" android:focusable="false" android:foreground="?attr/selectableItemBackground">
            <ImageView android:id="@+id/nav_account_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_user" android:importantForAccessibility="no" android:tint="@color/muted" />
            <TextView android:id="@+id/nav_account_label" style="@style/Caption" android:text="Tài khoản" android:layout_marginTop="5dp" android:layout_marginBottom="0dp" android:textColor="@color/muted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
